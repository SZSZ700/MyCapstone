<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot manages the compatible dependency ecosystem -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>mvproject</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>

        <!-- Java -->
        <java.version>23</java.version>

        <!-- Kotlin -->
        <kotlin.version>2.4.21</kotlin.version>

        <!--
            Security overrides over Spring Boot managed versions.
            These move the vulnerable transitive dependencies
            to newer patched versions.
        -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <logback.version>1.6.5</logback.version>
        <mongodb.version>5.13.0</mongodb.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>

    <dependencies>

        <!-- ========================================================= -->
        <!-- Spring -->
        <!-- ========================================================= -->

        <!-- Spring MVC + embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- BCrypt password hashing -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>


        <!-- ========================================================= -->
        <!-- MongoDB -->
        <!-- ========================================================= -->

        <!--
            Version is controlled by:
            <mongodb.version>5.13.0</mongodb.version>

            This keeps:
            mongodb-driver-sync
            mongodb-driver-core
            bson
            on the same version line.
        -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
        </dependency>


        <!-- ========================================================= -->
        <!-- HTTP -->
        <!-- ========================================================= -->

        <!-- OkHttp -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- JSON -->
        <!-- ========================================================= -->

        <!-- org.json -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <!--
            Jackson itself comes transitively from Spring Boot.

            Its version is controlled through:
            <jackson-bom.version>3.1.7</jackson-bom.version>
        -->


        <!-- ========================================================= -->
        <!-- Native access -->
        <!-- ========================================================= -->

        <!-- JNA -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>

        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- Environment variables -->
        <!-- ========================================================= -->

        <!-- Loads variables from local .env -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>java-dotenv</artifactId>
            <version>5.2.2</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- QR / Barcode -->
        <!-- ========================================================= -->

        <!-- ZXing core -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.4</version>
        </dependency>

        <!-- ZXing Java SE -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- JWT -->
        <!-- ========================================================= -->

        <!-- Nimbus JOSE + JWT -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.9</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- Nullability annotations -->
        <!-- ========================================================= -->

        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>


        <!-- ========================================================= -->
        <!-- Kotlin -->
        <!-- ========================================================= -->

        <!-- Kotlin standard library -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <!-- Required by Spring reflection / Kotlin integration -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>


        <!-- ========================================================= -->
        <!-- Testing -->
        <!-- ========================================================= -->
        <!-- Spring Boot 4 REST client infrastructure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <!-- TestRestTemplate support for Spring Boot 4 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Includes:
            JUnit Jupiter
            Mockito
            Spring Test
            AssertJ
            JSON support
            etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>

            <exclusions>

                <!--
                    We manage JSONAssert explicitly below
                    because of its android-json transitive dependency.
                -->
                <exclusion>
                    <groupId>org.skyscreamer</groupId>
                    <artifactId>jsonassert</artifactId>
                </exclusion>

            </exclusions>
        </dependency>

        <!-- JSONAssert used by integration tests -->
        <dependency>
            <groupId>org.skyscreamer</groupId>
            <artifactId>jsonassert</artifactId>
            <version>1.5.3</version>
            <scope>test</scope>

            <exclusions>

                <!-- Avoid android-json collision -->
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>

            </exclusions>
        </dependency>

    </dependencies>


    <!-- ============================================================= -->
    <!-- Build -->
    <!-- ============================================================= -->

    <build>

        <plugins>

            <!-- ===================================================== -->
            <!-- Spring Boot -->
            <!-- ===================================================== -->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <!-- ===================================================== -->
            <!-- Kotlin -->
            <!-- ===================================================== -->

            <plugin>

                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>

                <executions>

                    <!-- Compile main Kotlin source -->
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>

                        <goals>
                            <goal>compile</goal>
                        </goals>

                    </execution>

                    <!-- Compile Kotlin tests -->
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>

                        <goals>
                            <goal>test-compile</goal>
                        </goals>

                    </execution>

                </executions>

                <configuration>

                    <!-- Kotlin produces Java 23 compatible bytecode -->
                    <jvmTarget>${java.version}</jvmTarget>

                    <!--
                        Kotlin classes are final by default.

                        Spring frequently needs to create proxies,
                        therefore the Spring compiler plugin automatically
                        opens the required Spring-managed classes.
                    -->
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>

                </configuration>

                <dependencies>

                    <!-- Required for Kotlin Spring all-open plugin -->
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>

                </dependencies>

            </plugin>


            <!-- ===================================================== -->
            <!-- Java compiler -->
            <!-- ===================================================== -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>

                    <!--
                        Better than source + target.

                        release controls both:
                        - generated bytecode version
                        - available Java API level
                    -->
                    <release>${java.version}</release>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>