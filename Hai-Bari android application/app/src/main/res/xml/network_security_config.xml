<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Allow cleartext HTTP only for localhost in the debug build.
        This is required by MockWebServer, which runs over HTTP by default.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!--
        Keep the real Android Emulator backend connection on HTTPS.
        The local development certificate is trusted only for this endpoint.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.0.2.2</domain>

        <trust-anchors>
            <certificates src="@raw/hibari_local" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!--
        All other network traffic must use HTTPS and trusted system certificates.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>